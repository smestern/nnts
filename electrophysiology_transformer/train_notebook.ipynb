       "\n",
       "     <input type=\"file\" id=\"files-337a7d22-d5ac-4d37-859d-692bbaa3e15a\" name=\"files[]\" multiple disabled\n",
       "        style=\"border:none\" />\n",
       "     <output id=\"result-337a7d22-d5ac-4d37-859d-692bbaa3e15a\">\n",
